Model SysADLModel ; package SysADL.types { value type Int { } value type Boolean { } value type String { } value type Void { } value type Real { } dimension Currency unit BRL { dimension = Currency } value type Currency { dimension = Currency } value type BRLCurrency extends Currency { unit = BRL dimension = Currency } dimension Time unit Minutes { dimension = Time } value type Time { dimension = Time } value type MinutesTime extends Time { unit = Minutes dimension = Time } enum AccessType { Entry , Exit } enum PaymentMethod { Card , Cash } enum PaymentStatus { Approved , Denied } enum GateCommand { Open , Close } value type Plate extends String { } value type Timestamp extends String { } datatype Ticket { attributes : plate : Plate ; entryTime : Timestamp ; } datatype Charge { attributes : plate : Plate ; stay : MinutesTime ; amount : BRLCurrency ; } datatype PaymentRequest { attributes : plate : Plate ; method : PaymentMethod ; } datatype Payment { attributes : plate : Plate ; amount : BRLCurrency ; status : PaymentStatus ; time : Timestamp ; } datatype AccessEvent { attributes : plate : Plate ; time : Timestamp ; accessType : AccessType ; } datatype Occupancy { attributes : occupied : Capacity ; available : Capacity ; } value type Capacity extends Int { } datatype SystemConfig { attributes : capacity : Capacity ; hourlyRate : BRLCurrency ; } } Requirement ParkingManagementFR ( 1 ) { text = "The system must manage vehicle entry and exit, capacity configuration, and automated payment for various types of parking facilities." } package ParkingSystemComponents { import SysADL.types ; import ParkingSystemConnectors ; import ParkingSystemPorts ; boundary
	component def VehicleSensorCP { ports : detection : DetectionOPT ; } boundary
	component def BarrierGateCP { ports : command : CommandIPT ; } boundary
	component def PaymentKioskCP { ports : charge : ChargeIPT ; paymentRequest : PaymentRequestOPT ; } boundary
	component def DisplayBoardCP { ports : occupancy : OccupancyIPT ; } boundary
	component def AdminConsoleCP { ports : config : ConfigOPT ; }
	component def OccupancyManagerCP { }
	component def PaymentProcessorCP { ports : newPort : TicketIPT ; }
	component def AccessControllerCP { } component def ParkingSystemCP { configuration { components : VehicleSensorCP : VehicleSensorCP { using ports : detection : DetectionOPT ; } PaymentProcessorCP : PaymentProcessorCP { using ports : newPort : TicketIPT ; } AdminConsoleCP : AdminConsoleCP { using ports : config : ConfigOPT ; } DisplayBoardCP : DisplayBoardCP { using ports : occupancy : OccupancyIPT ; } AdminConsoleCP : AdminConsoleCP { using ports : config : ConfigOPT ; } OccupancyManagerCP : OccupancyManagerCP ; } }
	component def DataStoreCP { ports : save : TicketIPT ; found : ExitTicketOPT ; } } Requirement ManageVehicleAccessFR ( 1.1 ) { text = "The system must control physical access gates based on occupancy status and payment validation." satisfied by ParkingSystemComponents.BarrierGateCP ; derive ParkingManagementFR ; } Requirement DetectVehicleFR ( 1.1.1 ) { text = "The system must detect vehicle arrival at entry/exit gates and capture ticket/plate identifiers." satisfied by ParkingSystemComponents.VehicleSensorCP ; derive ManageVehicleAccessFR ; } Requirement ControlOccupancyFR ( 1.1.2 ) { text = "The system must monitor occupied parking spaces in real time, update availability displays, and block entry when maximum capacity is reached." satisfied by ParkingSystemComponents.DisplayBoardCP , ParkingSystemComponents.OccupancyManagerCP ; derive ManageVehicleAccessFR ; } Requirement AutomatedPaymentFR ( 1.2 ) { text = "The system must handle complete financial transactions for parking stays." derive ParkingManagementFR ; } Requirement CalculateTariffFR ( 1.2.1 ) { text = "The system must calculate the fee based on entry timestamp, current timestamp, vehicle type, and rate table." satisfied by ParkingSystemComponents.PaymentProcessorCP ; derive AutomatedPaymentFR ; } Requirement ProcessPaymentAndReleaseFR ( 1.2.2 ) { text = "The system must execute payment collection (card/cash/tag), confirm financial authorization, and issue the exit signal to the barrier." satisfied by ParkingSystemComponents.PaymentProcessorCP ; derive AutomatedPaymentFR ; } Requirement ConfigureCapacityAndVenueFR ( 1.3 ) { text = "The system must allow administrators to configure capacity limits, rate schedules, and operational rules for diverse venue sizes." satisfied by ParkingSystemComponents.AdminConsoleCP , ParkingSystemComponents.OccupancyManagerCP ; derive ParkingManagementFR ; } Requirement ProvideUserInterfaceFR ( 1.4 ) { text = "The system must provide interfaces for driver interaction at terminals and administrative management." satisfied by ParkingSystemComponents.PaymentKioskCP ; derive ParkingManagementFR ; } Requirement QualityNFR ( 2 ) { text = "The system must satisfy availability, scalability, security, and reliability quality concerns." }  Requirement Availability24x7NFR ( 2.1 ) { text = "The system must operate continuously 24 hours a day, 7 days a week without interruption." derive QualityNFR ; }  Requirement ScalabilityNFR ( 2.2 ) { text = "The system must scale dynamically to handle different capacities, from tens to thousands of parking spots." derive QualityNFR ; }  Requirement SecurityNFR ( 2.3 ) { text = "The system must protect financial transactions and access records against unauthorized access or tampering." derive QualityNFR ; }  Requirement ReliabilityNFR ( 2.4 ) { text = "The system must maintain accurate counts and transaction logs without data loss during power or network fluctuations." derive QualityNFR ; } package ParkingSystemConnectors { import ParkingSystemPorts ; connector def AccessEventCN { participants : ~ source : DetectionOPT ; ~ destination : EventIPT ; flows : AccessEvent from source to destination } connector def GateCommandCN { participants : ~ source : GateCommandOPT ; ~ destination : CommandIPT ; flows : GateCommand from source to destination } connector def SaveTicketCN { participants : ~ source : SaveTicketOPT ; ~ destination : SaveIPT ; flows : Ticket from source to destination } connector def QueryConnectorCN { participants : ~ source : QueryTicketOPT ; ~ destination : QueryIPT ; flows : Plate from source to destination } connector def FoundTicketCN { participants : ~ source : FoundOPT ; ~ destination : FoundTicketIPT ; flows : Ticket from source to destination } connector def ExitTicketCN { participants : ~ source : ExitTicketOPT ; ~ destination : TicketIPT ; flows : Ticket from source to destination } connector def ChargeCN { participants : ~ source : ChargeOPT ; ~ destination : ChargeIPT ; flows : Charge from source to destination } connector def PaymentRequestCN { participants : ~ source : PaymentRequestOPT ; ~ destination : PaymentRequestIPT ; flows : PaymentRequest from source to destination } connector def PaymentCN { participants : ~ source : PaymentOPT ; ~ destination : PaymentIPT ; flows : Payment from source to destination } connector def OccupancyCN { participants : ~ source : OccupancyOPT ; ~ destination : OccupancyIPT ; flows : Occupancy from source to destination } connector def ConfigCN { participants : ~ source : ConfigOPT ; ~ destination : ConfigIPT ; flows : SystemConfig from source to destination } } package ParkingSystemPorts { import SysADL.types ; port def OccupancyIPT { flow in Occupancy } port def ConfigOPT { flow out SystemConfig } port def SaveIPT { flow in Ticket } port def QueryIPT { flow in Plate } port def FoundOPT { flow out Ticket } port def ChargeIPT { flow in Charge } port def PaymentRequestOPT { flow out PaymentRequest } port def DetectionOPT { flow out AccessEvent } port def CommandIPT { flow in GateCommand } port def EventIPT { flow in AccessEvent } port def GateCommandOPT { flow out GateCommand } port def SaveTicketOPT { flow out Ticket } port def QueryTicketOPT { flow out Plate } port def FoundTicketIPT { flow in Ticket } port def ExitTicketOPT { flow out Ticket } port def PaymentIPT { flow in Payment } port def OccupancyOPT { flow out Occupancy } port def TicketIPT { flow in Ticket } port def ConfigIPT { flow in SystemConfig } port def ChargeOPT { flow out Charge } port def PaymentRequestIPT { flow in PaymentRequest } port def PaymentOPT { flow out Payment } }