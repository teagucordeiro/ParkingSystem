Model SysADLModel ; package SysADL.types { value type Int { } value type Boolean { } value type String { } value type Void { } value type Real { } } Requirement ParkingManagementFR ( 1 ) { text = "The system must manage vehicle entry and exit, capacity configuration, and automated payment for various types of parking facilities." } package newElement { import SysADL.types ; boundary
	component def VehicleSensorCP { } boundary
	component def BarrierGateCP { } boundary
	component def PaymentKioskCP { } boundary
	component def DisplayBoardCP { } boundary
	component def AdminConsoleCP { }
	component def OccupancyManagerCP { }
	component def PaymentProcessorCP { }
	component def AccessControllerCP { } } Requirement ManageVehicleAccessFR ( 1.1 ) { text = "The system must control physical access gates based on occupancy status and payment validation." satisfied by newElement.BarrierGateCP ; derive ParkingManagementFR ; } Requirement DetectVehicleFR ( 1.1.1 ) { text = "The system must detect vehicle arrival at entry/exit gates and capture ticket/plate identifiers." satisfied by newElement.VehicleSensorCP ; derive ManageVehicleAccessFR ; } Requirement ControlOccupancyFR ( 1.1.2 ) { text = "The system must monitor occupied parking spaces in real time, update availability displays, and block entry when maximum capacity is reached." satisfied by newElement.DisplayBoardCP , newElement.OccupancyManagerCP ; derive ManageVehicleAccessFR ; } Requirement AutomatedPaymentFR ( 1.2 ) { text = "The system must handle complete financial transactions for parking stays." derive ParkingManagementFR ; } Requirement CalculateTariffFR ( 1.2.1 ) { text = "The system must calculate the fee based on entry timestamp, current timestamp, vehicle type, and rate table." satisfied by newElement.PaymentProcessorCP ; derive AutomatedPaymentFR ; } Requirement ProcessPaymentAndReleaseFR ( 1.2.2 ) { text = "The system must execute payment collection (card/cash/tag), confirm financial authorization, and issue the exit signal to the barrier." satisfied by newElement.PaymentProcessorCP ; derive AutomatedPaymentFR ; } Requirement ConfigureCapacityAndVenueFR ( 1.3 ) { text = "The system must allow administrators to configure capacity limits, rate schedules, and operational rules for diverse venue sizes." satisfied by newElement.AdminConsoleCP , newElement.OccupancyManagerCP ; derive ParkingManagementFR ; } Requirement ProvideUserInterfaceFR ( 1.4 ) { text = "The system must provide interfaces for driver interaction at terminals and administrative management." satisfied by newElement.PaymentKioskCP ; derive ParkingManagementFR ; } Requirement QualityNFR ( 2 ) { text = "The system must satisfy availability, scalability, security, and reliability quality concerns." derive Availability24x7NFR , ScalabilityNFR , SecurityNFR , ReliabilityNFR ; } Requirement Availability24x7NFR ( 2.1 ) { text = "The system must operate continuously 24 hours a day, 7 days a week without interruption." } Requirement ScalabilityNFR ( 2.2 ) { text = "The system must scale dynamically to handle different capacities, from tens to thousands of parking spots." } Requirement SecurityNFR ( 2.3 ) { text = "The system must protect financial transactions and access records against unauthorized access or tampering." } Requirement ReliabilityNFR ( 2.4 ) { text = "The system must maintain accurate counts and transaction logs without data loss during power or network fluctuations." }