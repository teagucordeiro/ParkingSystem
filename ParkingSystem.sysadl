Model SysADLModel ; package SysADL.types { value type Int { } value type Boolean { } value type String { } value type Void { } value type Real { } dimension Currency unit BRL { dimension = Currency } value type Currency { dimension = Currency } value type BRLCurrency extends Currency { unit = BRL dimension = Currency } dimension Time unit Minutes { dimension = Time } value type Time { dimension = Time } value type MinutesTime extends Time { unit = Minutes dimension = Time } enum AccessType { Entry , Exit } enum PaymentMethod { Card , Cash } enum PaymentStatus { Approved , Denied } enum GateCommand { Open , Close } value type Plate extends String { } value type Timestamp extends String { }  datatype Charge { attributes : plate : Plate ; stay : MinutesTime ; amount : BRLCurrency ; } datatype PaymentRequest { attributes : plate : Plate ; method : PaymentMethod ; } datatype Payment { attributes : plate : Plate ; amount : BRLCurrency ; status : PaymentStatus ; time : Timestamp ; } datatype AccessEvent { attributes : plate : Plate ; time : Timestamp ; accessType : AccessType ; laneId : LaneId ; } datatype Occupancy { attributes : occupied : Capacity ; available : Capacity ; } value type Capacity extends Int { } datatype SystemConfig { attributes : capacity : Capacity ; hourlyRate : BRLCurrency ; } value type LaneId extends Int { } enum PresenceState { VehiclePresent , Clear } enum GateState { Opened , Closed } enum DecisionResult { Authorized , DeniedFull , DeniedUnpaid } datatype StayRecord { attributes : plate : Plate ; entryTIme : Timestamp ; referenceTime : Timestamp ; } datatype EntryRecord { attributes : plate : Plate ; entryTime : Timestamp ; exitTime : Timestamp ; paidAt : Timestamp ; } datatype PlateReading { attributes : plate : Plate ; time : Timestamp ; } datatype AccessDecision { attributes : plate : Plate ; laneId : LaneId ; result : DecisionResult ; } } Requirement ParkingManagementFR ( 1 ) { text = "The system must manage vehicle entry and exit, capacity configuration, and automated payment for various types of parking facilities." satisfied by ParkingSystemComponents.ParkingSystem ; Requirement ManageVehicleAccessFR ( 1.1 ) { text = "The system must control physical access gates based on occupancy status and payment validation." Requirement DetectVehicleFR ( 1.1.1 ) { text = "The system must detect vehicle arrival at entry/exit lanes and capture the plate identifier." satisfied by ParkingSystemComponents.InductiveLoopDetectorCP , ParkingSystemComponents.PlateRecognitionCameraCP ; derive ManageVehicleAccessFR ; } Requirement ControlOccupancyFR ( 1.1.2 ) { text = "The system must monitor occupied parking spaces in real time, update availability displays, and block entry when maximum capacity is reached." satisfied by ParkingSystemComponents.DisplayBoardCP , ParkingSystemComponents.AccessControlManagerCP ; derive ManageVehicleAccessFR ; } } Requirement AutomatedPaymentFR ( 1.2 ) { text = "The system must handle complete financial transactions for parking stays." Requirement CalculateTariffFR ( 1.2.1 ) { text = "The system must calculate the fee based on entry timestamp, current timestamp, and rate table." satisfied by ParkingSystemComponents.TariffCalculatorCP ; derive AutomatedPaymentFR ; } Requirement ProcessPaymentAndReleaseFR ( 1.2.2 ) { text = "The system must collect payment at a payment station (card/cash), confirm financial authorization, and authorize the exit at the barrier." satisfied by ParkingSystemComponents.PaymentStationCP , ParkingSystemComponents.PaymentServiceCP , ParkingSystemComponents.AccessControlManagerCP ; derive AutomatedPaymentFR ; } } Requirement ConfigureCapacityAndVenueFR ( 1.3 ) { text = "The system must allow administrators to configure capacity limits, rate schedules, and operational rules for diverse venue sizes." satisfied by ParkingSystemComponents.AdminWorkstationCP ; } Requirement ProvideUserInterfaceFR ( 1.4 ) { text = "The system must provide interfaces for driver interaction at terminals and administrative management." satisfied by ParkingSystemComponents.DisplayBoardCP , ParkingSystemComponents.AdminWorkstationCP , ParkingSystemComponents.PaymentStationCP , ParkingSystemComponents.TouchscreenCP ; } } package ParkingSystemComponents { import SysADL.types ; import ParkingSystemConnectors ; import ParkingSystemPorts ;  boundary
	component def BarrierGateCP { ports :  command : CommandIPT ; state : StateOPT ; } boundary
	component def DisplayBoardCP { ports :  occupancy : OccupancyIPT ; }
	component def CashAcceptorCP { ports : order : OrderIPT ; result : ResultOPT ; } component def ParkingSystem { configuration { components :    DisplayBoardCP : DisplayBoardCP { using ports :  } } } boundary
	component def InductiveLoopDetectorCP { ports : presence : PresenceOPT ; }
	component def PlateRecognitionCameraCP { ports : trigger : TriggerIPT ; reading : ReadingOPT ; }
	component def AccessControlManagerCP { ports : accessEvent : AccessEventIPT ; accessDecision : AccessDecisionOPT ; plateQuery : PlateQueryIPT ; saveRecord : SaveRecordOPT ; queryRecord : QueryRecordOPT ; foundRecord : FoundRecordIPT ; stay : StayOPT ; confirmedPayment : ConfirmedPaymentIPT ; occupancy : OccupancyOPT ; config : ConfigIPT ; }
	component def TariffCalculatorCP { ports : stay : StayIPT ; systemConfig : ConfigIPT ; charge : ChargeOPT ; } component def PaymentStationCP { ports : plate : PlateQueryOPT ; charge : ChargeIPT ; payment : PaymentOPT ; }
	component def PaymentServiceCP { ports : charge : ChargeIPT ; payment : PaymentIPT ; confirmedPayment : ConfirmedPaymentOPT ; }
	component def AdminWorkstationCP { ports : systemConfig : ConfigOPT ; }
	component def TouchscreenCP { ports : charge : ChargeIPT ; plate : PlateQueryOPT ; cardOrder : ChargeOPT ; cashOrder : ChargeOPT ; cardResult : CardResultIPT ; cashresult : CashResultIPT ; payment : PaymentOPT ; }
	component def LaneControllerCP { ports : presence : PresenceIPT ; plate : PlateIPT ; gateCommand : GateCommandOPT ; gateState : GateStateIPT ; accessEvent : AccessEventOPT ; accessDecision : AccessDecisionIPT ; }
	component def AccessLaneCP { ports : accessEvent : AccessEventOPT ; accessDecision : AccessDecisionIPT ; }
	component def CardTerminalCP { ports : order : OrderIPT ; result : ResultOPT ; }
	component def ParkingServerCP { ports : accessEvent : AccessEventIPT ; accessDecision : AccessDecisionOPT ; plateQuery : PlateQueryIPT ; charge : ChargeOPT ; payment : PaymentIPT ; occupancy : OccupancyOPT ; config : ConfigIPT ; } } Requirement QualityNFR ( 2 ) { text = "The system must satisfy availability, scalability, security, and reliability quality concerns." satisfied by ParkingSystemComponents.ParkingSystem ; }  Requirement Availability24x7NFR ( 2.1 ) { text = "The system must operate continuously 24 hours a day, 7 days a week without interruption." derive QualityNFR ; }       package ParkingSystemConnectors { import ParkingSystemPorts ;            connector def PresenceSignalCN { participants : ~ source : PresenceOPT ; ~ destination : PresenceIPT ; flows : PresenceState from source to destination }  connector def PlateReadingCN { participants : ~ source : ReadingOPT ; ~ destination : PlateIPT ; flows : PlateReading from source to destination }  connector def GateCommandCN { participants : ~ source : GateCommandOPT ; ~ destination : CommandIPT ; flows : GateCommand from source to destination }  connector def GateStateCN { participants : ~ source : StateOPT ; ~ destination : GateStateIPT ; flows : GateState from source to destination }  connector def AccessEventCN { participants : ~ source : AccessEventOPT ; ~ destination : AccessEventIPT ; flows : AccessEvent from source to destination }  connector def AccessDecisionCN { participants : ~ source : AccessDecisionOPT ; ~ destination : AccessDecisionIPT ; flows : AccessDecision from source to destination }  connector def PlateQueryCN { participants : ~ source : PlateQueryOPT ; ~ destination : PlateQueryIPT ; flows : Plate from source to destination }  connector def ChargeCN { participants : ~ source : ChargeOPT ; ~ destination : ChargeIPT ; flows : Charge from source to destination }  connector def PaymentOrderCN { participants : ~ source : ChargeOPT ; ~ destination : ChargeIPT ; flows : Charge from source to destination }  connector def PaymentCN { participants : ~ source : PaymentOPT ; ~ destination : PaymentIPT ; flows : Payment from source to destination }  connector def OccupancyCN { participants : ~ source : OccupancyOPT ; ~ destination : OccupancyIPT ; flows : Occupancy from source to destination } connector def ConfigCN { participants : ~ source : ConfigOPT ; ~ destination : ConfigIPT ; flows : SystemConfig from source to destination } connector def RecordCN { participants : ~ source : SaveRecordOPT ; ~ destination : FoundRecordIPT ; flows : EntryRecord from source to destination } connector def StayConnector { participants : ~ source : StayOPT ; ~ destination : StayIPT ; flows : StayRecord from source to destination } } package ParkingSystemPorts { import SysADL.types ;      port def ChargeIPT { flow in Charge }   port def CommandIPT { flow in GateCommand }  port def GateCommandOPT { flow out GateCommand }     port def PaymentIPT { flow in Payment } port def OccupancyOPT { flow out Occupancy }  port def ConfigIPT { flow in SystemConfig } port def ChargeOPT { flow out Charge } port def PaymentRequestIPT { flow in PaymentRequest } port def PaymentOPT { flow out Payment } port def PresenceOPT { flow out PresenceState } port def PresenceIPT { flow in PresenceState }  port def TriggerIPT { flow in PresenceState }  port def ReadingOPT { flow out PlateReading }  port def StateOPT { flow out GateState }  port def PlateIPT { flow in PlateReading } port def GateStateIPT { flow in GateState } port def AccessEventOPT { flow out AccessEvent }  port def AccessDecisionIPT { flow in AccessDecision } port def PlateQueryOPT { flow out Plate } port def CardResultIPT { flow in Payment } port def CashResultIPT { flow in Payment } port def PaymentOPT { flow out Payment } port def OrderIPT { flow in Charge } port def ResultOPT { flow out Payment } port def OccupancyIPT { flow in Occupancy } port def ConfigOPT { flow out SystemConfig } port def AccessEventIPT { flow in AccessEvent } port def AccessDecisionOPT { flow out AccessDecision } port def PlateQueryIPT { flow in Plate } port def ChargeOPT { flow out Charge } port def ConfigIPT { flow in SystemConfig } port def SaveRecordOPT { flow out EntryRecord } port def QueryRecordOPT { flow out Plate } port def FoundRecordIPT { flow in EntryRecord } port def StayOPT { flow out StayRecord } port def confirmedPaymentIPT { flow in Payment } port def StayIPT { flow in StayRecord } port def ConfirmedPaymentIPT { flow in Payment } port def ConfirmedPaymentOPT { flow out Payment } port def SaveIPT { flow in EntryRecord } port def QueryIPT { flow in Plate } }
